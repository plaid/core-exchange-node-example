{
  "name": "@apps/auth",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm css:watch\" \"tsx watch src/index.ts\"",
    "css:build": "pnpm exec tailwindcss -i ./src/css/input.css -o ./public/styles.css",
    "css:watch": "pnpm exec tailwindcss -i ./src/css/input.css -o ./public/styles.css --watch",
    "build": "pnpm css:build && tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apps/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "oidc-provider": "^9.8.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}